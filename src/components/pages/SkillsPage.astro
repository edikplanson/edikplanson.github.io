---
import Layout from "../../layouts/Layout.astro";
import PageHeading from "../PageHeading.astro";
import { siteConfig, getContent } from "../../config";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const c = getContent(lang);
---

<Layout pageTitle={t("nav.skills")}>
  <PageHeading title={t("nav.skills")} subtitle={t("skills.subtitle")} />

  <section class="p-8 sm:p-12 md:p-16 lg:px-24 lg:py-16">
    <div class="max-w-5xl space-y-16">
      {
        c.skillCategories.map((category, ci) => (
          <div>
            <h2 class="text-2xl sm:text-3xl font-bold text-[var(--vs-fg)]">
              {category.title}
            </h2>
            <div
              class="w-[50px] h-[4px] mt-2 mb-8 rounded-full"
              style={`background-color: ${siteConfig.palette[ci % siteConfig.palette.length]}`}
            />

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              {category.groups.map((group, gi) => (
                <div
                  class="gutter bg-[var(--vs-bg-inset)] md:bg-[var(--vs-bg-inset)]/90 md:backdrop-blur-sm rounded-lg shadow-sm border border-[var(--vs-border)] p-5 md:p-6 pl-6 md:pl-7 hover:shadow-md transition-shadow duration-300"
                  style={`--gutter-color: ${siteConfig.palette[(ci + gi) % siteConfig.palette.length]}`}
                >
                  <h3
                    class="text-lg font-semibold mb-4"
                    style={`color: ${siteConfig.palette[(ci + gi) % siteConfig.palette.length]}`}
                  >
                    {group.name}
                  </h3>
                  <ul class="space-y-2">
                    {group.items.map((item) => (
                      <li class="flex items-start">
                        <span class="inline-block w-1.5 h-1.5 rounded-full bg-gray-400 mt-2 mr-3 flex-shrink-0" />
                        <span class="text-sm sm:text-base text-gray-600">
                          {item}
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</Layout>
