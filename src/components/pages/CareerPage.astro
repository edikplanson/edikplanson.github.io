---
import Layout from "../../layouts/Layout.astro";
import PageHeading from "../PageHeading.astro";
import { siteConfig, getContent } from "../../config";
import { cvPath, getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const c = getContent(lang);

/* The CV of the page's own language first: it is the one most visitors want. */
const cvs = (lang === "fr" ? (["fr", "en"] as const) : (["en", "fr"] as const)).map(
  (code) => ({
    code,
    label: code === "fr" ? t("cv.french") : t("cv.english"),
    href: cvPath(code),
    action: t("cv.view"),
  }),
);

/* LinkedIn leads on its own row, so the two CVs sit side by side below it;
   it drops out while `social.linkedin` is empty. */
const links = [
  ...(siteConfig.social.linkedin
    ? [
        {
          code: undefined,
          wide: true,
          label: t("career.linkedin"),
          href: siteConfig.social.linkedin,
          action: t("career.linkedinView"),
        },
      ]
    : []),
  ...cvs,
].map((link, i) => ({
  ...link,
  color: siteConfig.palette[i % siteConfig.palette.length],
}));
---

<Layout pageTitle={t("nav.career")}>
  <PageHeading title={t("nav.career")} subtitle={t("career.subtitle")} />

  <section class="p-8 sm:p-12 md:p-16 lg:px-24 lg:py-16">
    <p
      class="max-w-3xl mb-8 flex items-center gap-2 text-lg sm:text-xl font-bold"
      style={`color: ${siteConfig.accentColor}`}
    >
      <span
        aria-hidden="true"
        class="w-2.5 h-2.5 rounded-full shrink-0"
        style={`background-color: ${siteConfig.accentColor}`}
      ></span>
      {c.lookingFor}
    </p>
    <div class="max-w-3xl grid grid-cols-1 sm:grid-cols-2 gap-6">
      {
        links.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener"
            hreflang={link.code}
            class:list={[
              "gutter group bg-[var(--vs-bg-inset)] md:bg-[var(--vs-bg-inset)]/90 md:backdrop-blur-sm rounded-lg shadow-sm border border-[var(--vs-border)] p-5 md:p-6 pl-6 md:pl-7 transition-colors hover:border-[var(--vs-border-strong)]",
              "wide" in link && "sm:col-span-2",
            ]}
            style={`--gutter-color: ${link.color}`}
          >
            <p class="text-sm text-[var(--vs-fg-muted)] mb-2">{link.label}</p>
            <span
              class="flex items-center gap-2 text-base sm:text-lg font-medium transition-opacity group-hover:opacity-70"
              style={`color: ${link.color}`}
            >
              <svg
                aria-hidden="true"
                class="w-4 h-4 shrink-0"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M14 4h6v6" />
                <path d="M20 4l-8 8" />
                <path d="M18 14v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4" />
              </svg>
              {link.action}
            </span>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
