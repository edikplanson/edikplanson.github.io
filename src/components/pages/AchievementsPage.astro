---
import Layout from "../../layouts/Layout.astro";
import PageHeading from "../PageHeading.astro";
import Experience from "../Experience.astro";
import { getContent } from "../../config";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const c = getContent(lang);
---

<Layout pageTitle={t("nav.achievements")}>
  <PageHeading title={t("nav.achievements")} subtitle={t("achievements.subtitle")} />
  <Experience items={c.achievements} id="achievements" />
</Layout>
