---
import { siteConfig, getContent } from "../config";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const c = getContent(lang);
const hasExperience = c.experience && c.experience.length > 0;
---

{
  hasExperience && (
    <section id="experience" class="p-8 sm:p-12 md:p-16 lg:px-24 lg:py-16">
      <div>
        <div class="max-w-6xl">
          <div>
            <div class="relative">
              {c.experience.map((exp, index) => {
                const color =
                  siteConfig.palette[index % siteConfig.palette.length];
                const logo = "logo" in exp ? (exp.logo as string) : undefined;
                return (
                <div class="relative mb-12 last:mb-0">
                  {/* Timeline dot at top of card */}
                  <div
                    class="absolute left-1/2 -top-2 w-4 h-4 bg-white border-2 rounded-full -translate-x-1/2 z-20 transition-all duration-300"
                    style={`border-color: ${color}; background-color: ${color}`}
                  />

                  {/* Connecting line below card */}
                  {index < c.experience.length - 1 && (
                    <div class="absolute left-1/2 bottom-0 w-0.5 h-12 bg-[var(--vs-border-strong)] -translate-x-1/2 translate-y-full z-10" />
                  )}

                  {/* Experience card */}
                  <div
                    class="gutter bg-[var(--vs-bg-inset)] md:bg-[var(--vs-bg-inset)]/90 md:backdrop-blur-sm rounded-lg shadow-sm border border-[var(--vs-border)] p-4 sm:p-5 md:p-6 pl-6 sm:pl-7 md:pl-8 hover:shadow-md transition-shadow duration-300"
                    style={`--gutter-color: ${color}`}
                  >
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-4">
                      <div class="flex items-center gap-4 min-w-0">
                        {logo && (
                          <img
                            src={logo}
                            alt=""
                            loading="lazy"
                            decoding="async"
                            width="96"
                            height="64"
                            class="w-20 h-14 sm:w-24 sm:h-16 shrink-0 rounded-lg object-contain p-1.5 ring-1 ring-[var(--vs-border)] shadow-sm"
                            style="background-color: #ffffff"
                          />
                        )}
                        <div class="min-w-0">
                          <h3 class="text-lg sm:text-xl font-semibold text-[var(--vs-fg)]">
                            {exp.title}
                          </h3>
                          <p class="text-base sm:text-lg" style={`color: ${color}`}>
                            {exp.company}
                          </p>
                        </div>
                      </div>
                      <span class="text-xs sm:text-sm text-[var(--vs-fg-muted)] mt-2 sm:mt-0 shrink-0 whitespace-nowrap">
                        {exp.dateRange}
                      </span>
                    </div>

                    <ul class="space-y-2">
                      {exp.bullets.map((bullet) => (
                        <li class="flex items-start">
                          <span class="inline-block w-1.5 h-1.5 rounded-full bg-gray-400 mt-2 mr-3 flex-shrink-0" />
                          <span class="text-sm sm:text-base text-gray-600">
                            {bullet}
                          </span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
                );
              })}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
