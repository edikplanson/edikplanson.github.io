---
import { siteConfig, getContent } from "../config";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const c = getContent(lang);

const socials = [
  siteConfig.social.email && {
    href: `mailto:${siteConfig.social.email}`,
    label: "Email",
    color: siteConfig.palette[0],
    paths: [
      "M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z",
      "M3 7l9 6l9 -6",
    ],
  },
  siteConfig.social.linkedin && {
    href: siteConfig.social.linkedin,
    label: "LinkedIn",
    color: siteConfig.palette[1],
    paths: [
      "M8 11v5",
      "M8 8v.01",
      "M12 16v-5",
      "M16 16v-3a2 2 0 1 0 -4 0",
      "M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z",
    ],
  },
  siteConfig.social.twitter && {
    href: siteConfig.social.twitter,
    label: "Twitter",
    color: siteConfig.palette[2],
    paths: [
      "M4 4l11.733 16h4.267l-11.733 -16z",
      "M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772",
    ],
  },
  siteConfig.social.github && {
    href: siteConfig.social.github,
    label: "GitHub",
    color: siteConfig.palette[3],
    paths: [
      "M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5",
    ],
  },
].filter(Boolean) as {
  href: string;
  label: string;
  color: string;
  paths: string[];
}[];
---

<div
  id="hero"
  class="relative isolate overflow-hidden pt-28 pb-24 md:h-screen md:pt-24 md:pb-0"
>

  <!-- Editor grid -->
  <svg
    aria-hidden="true"
    class="absolute inset-0 -z-10 size-full [mask-image:radial-gradient(120%_100%_at_0%_0%,black,transparent_75%)]"
  >
    <defs>
      <pattern
        id="grid"
        width="28"
        height="28"
        patternUnits="userSpaceOnUse"
      >
        <path
          d="M28 0H0V28"
          fill="none"
          stroke="var(--vs-border-strong)"
          stroke-width="1"></path>
      </pattern>

    </defs>
    <rect width="100%" height="100%" fill="url(#grid)" opacity="0.5"></rect>
  </svg>

  <div class="h-full mx-auto px-8 sm:px-12 md:px-24 flex items-center">
    <div class="w-full">
      <p
        class="tok-comment text-sm sm:text-base md:text-lg animate-fade-in"
        style="font-style: italic"
      >
        {t("hero.greeting")}
      </p>

      <h1
        class="mt-4 sm:mt-6 md:mt-8 text-pretty text-4xl sm:text-5xl md:text-6xl lg:text-8xl font-bold tracking-tight text-[var(--vs-fg)] animate-fade-in animation-delay-200"
      >
        <span class="text-[var(--vs-fg-muted)] font-normal"
          >{t("hero.intro")}</span
        >
        <span class="cursor" style={`color: ${siteConfig.accentColor}`}
          >{siteConfig.name}</span
        >
      </h1>

      <p
        class="mt-4 sm:mt-6 md:mt-8 text-pretty text-base sm:text-lg md:text-xl/8 text-[var(--vs-fg-body)] animate-fade-in animation-delay-400"
      >
        {c.title}
      </p>

      <!-- Skill tokens, each in its own syntax colour -->
      <ul
        class="mt-8 md:mt-10 flex flex-wrap gap-x-3 gap-y-2 text-xs sm:text-sm animate-fade-in animation-delay-600"
      >
        {
          c.skills.slice(0, 6).map((skill, i) => (
            <li
              class="px-2 py-1 rounded border bg-[var(--vs-bg-inset)]"
              style={`color: ${siteConfig.palette[i % siteConfig.palette.length]}; border-color: var(--vs-border)`}
            >
              {skill}
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div
    class="mt-12 md:mt-0 md:absolute md:bottom-0 md:left-0 md:right-0 px-8 sm:px-12 md:p-24 flex gap-x-5 sm:gap-x-6 animate-fade-in animation-delay-600"
  >
    {
      socials.map((s) => (
        <a
          href={s.href}
          target={s.href.startsWith("mailto:") ? undefined : "_blank"}
          rel={s.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
          aria-label={s.label}
          class="text-[var(--vs-fg-muted)] transition-colors duration-300 hover:text-[var(--hover-color)]"
          style={`--hover-color: ${s.color}`}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-6 w-6 sm:h-7 sm:w-7"
          >
            {s.paths.map((d) => (
              <path d={d} />
            ))}
          </svg>
        </a>
      ))
    }
  </div>
</div>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fadeIn 0.8s ease-out forwards;
    opacity: 0;
  }

  .animation-delay-200 {
    animation-delay: 0.2s;
  }

  .animation-delay-400 {
    animation-delay: 0.4s;
  }

  .animation-delay-600 {
    animation-delay: 0.6s;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-fade-in {
      animation: none;
      opacity: 1;
    }
  }
</style>
