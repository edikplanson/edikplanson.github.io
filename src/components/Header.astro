---
import { siteConfig } from "../config";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import {
  cvPath,
  getLangFromUrl,
  getRouteFromUrl,
  localizePath,
  useTranslations,
  visibleNavItems,
} from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentRoute = getRouteFromUrl(Astro.url);
const cvHref = cvPath(lang);

/* Each tab carries its own syntax colour, like file-type icons in a sidebar. */
const tabs = visibleNavItems(lang).map((item, i) => ({
  ...item,
  color: siteConfig.palette[i % siteConfig.palette.length],
  active: currentRoute === item.route,
}));
---

<header
  id="header"
  class="fixed top-0 left-0 right-0 z-50 bg-[var(--vs-bg-subtle)]/95 backdrop-blur-sm border-b border-[var(--vs-border)]"
>
  <nav class="max-w-7xl mx-auto flex items-stretch">
    <ul class="tab-strip flex flex-1 min-w-0 items-stretch flex-nowrap overflow-x-auto">
      {
        tabs.map((tab) => (
          <li class="flex">
            <a
              href={localizePath(tab.route, lang)}
              aria-current={tab.active ? "page" : undefined}
              class={`group flex items-center gap-2 px-3 sm:px-4 py-3 text-xs sm:text-sm whitespace-nowrap border-r border-[var(--vs-border)] transition-colors ${
                tab.active
                  ? "bg-[var(--vs-bg)] text-[var(--vs-fg)] font-medium border-t-2"
                  : "text-[var(--vs-fg-muted)] border-t-2 border-t-transparent hover:bg-[var(--vs-bg)]/60 hover:text-[var(--vs-fg)]"
              }`}
              style={tab.active ? `border-top-color: ${tab.color}` : undefined}
            >
              <span
                aria-hidden="true"
                class="w-2 h-2 rounded-full shrink-0 transition-opacity"
                style={`background-color: ${tab.color}; opacity: ${tab.active ? 1 : 0.4}`}
              />
              {t(tab.key)}
            </a>
          </li>
        ))
      }
    </ul>
    <div
      class="flex shrink-0 items-center gap-1 sm:gap-2 px-2 sm:px-4 border-l border-[var(--vs-border)]"
    >
      <a
        href={cvHref}
        target="_blank"
        rel="noopener"
        aria-label={t("cv.openCurrent")}
        title={t("cv.openCurrent")}
        class="flex items-center gap-1.5 px-2 py-2 rounded border border-[var(--vs-border-strong)] text-xs sm:text-sm text-[var(--vs-fg-muted)] transition-colors hover:text-[var(--vs-fg)] hover:bg-[var(--vs-bg)]"
      >
        <svg
          aria-hidden="true"
          class="w-3.5 h-3.5 shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M14 3v4a1 1 0 0 0 1 1h4" />
          <path
            d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2z"
          />
          <path d="M9 13h6" />
          <path d="M9 17h3" />
        </svg>
        {t("cv.label")}
      </a>
      <LanguageSwitcher />
    </div>
  </nav>
</header>

<style>
  /* Hide the tab-strip scrollbar; the row is still swipeable. */
  .tab-strip {
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
  }
  .tab-strip::-webkit-scrollbar {
    display: none;
  }
</style>
