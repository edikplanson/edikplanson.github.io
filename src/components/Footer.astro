---
import { siteConfig, getContent } from "../config";
import {
  getLangFromUrl,
  localizePath,
  useTranslations,
  visibleNavItems,
} from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const c = getContent(lang);

const icons = {
  email:
    '<path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" /><path d="M3 7l9 6l9 -6" />',
  linkedin:
    '<path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M8 11v5" /><path d="M8 8v.01" /><path d="M12 16v-5" /><path d="M16 16v-3a2 2 0 1 0 -4 0" /><path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z" />',
  twitter:
    '<path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M4 4l11.733 16h4.267l-11.733 -16z" /><path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772" />',
  github:
    '<path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" />',
};

const socials = [
  siteConfig.social.email && {
    href: `mailto:${siteConfig.social.email}`,
    label: "Email",
    icon: icons.email,
    external: false,
  },
  siteConfig.social.linkedin && {
    href: siteConfig.social.linkedin,
    label: "LinkedIn",
    icon: icons.linkedin,
    external: true,
  },
  siteConfig.social.twitter && {
    href: siteConfig.social.twitter,
    label: "Twitter",
    icon: icons.twitter,
    external: true,
  },
  siteConfig.social.github && {
    href: siteConfig.social.github,
    label: "GitHub",
    icon: icons.github,
    external: true,
  },
].filter(Boolean) as {
  href: string;
  label: string;
  icon: string;
  external: boolean;
}[];
---

<footer class="relative bg-[var(--vs-bg-subtle)] border-t border-[var(--vs-border)]">
  <div class="mx-auto max-w-6xl px-6 py-12 lg:px-8">
    <div
      class="flex flex-col md:flex-row md:items-center md:justify-between gap-8"
    >
      <div class="flex flex-col gap-4">
        <h3 class="text-2xl font-bold text-[var(--vs-fg)]">
          {siteConfig.name}
        </h3>
        <p class="text-base text-[var(--vs-fg-body)]">
          {c.title}
        </p>
        <div class="flex gap-x-6">
          {
            socials.map((s, i) => (
              <a
                href={s.href}
                target={s.external ? "_blank" : undefined}
                rel={s.external ? "noopener noreferrer" : undefined}
                aria-label={s.label}
                class="text-[var(--vs-fg-muted)] transition-colors duration-300 hover:text-[var(--hover-color)]"
                style={`--hover-color: ${siteConfig.palette[i % siteConfig.palette.length]}`}
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-6 w-6"
                  set:html={s.icon}
                />
              </a>
            ))
          }
        </div>
      </div>

      <div class="hidden md:flex flex-col md:items-end gap-4">
        <nav class="flex flex-wrap gap-x-6 gap-y-2 md:justify-end">
          {
            visibleNavItems(lang).map((link) => (
              <a
                href={localizePath(link.route, lang)}
                class="text-sm text-[var(--vs-fg-muted)] hover:text-[var(--vs-fg)] transition-colors"
              >
                {t(link.key)}
              </a>
            ))
          }
        </nav>
        <p class="text-sm text-[var(--vs-fg-muted)]">
          © {new Date().getFullYear()}
          {siteConfig.name}. {t("footer.rights")}
        </p>
      </div>
    </div>
  </div>

  <!-- Decorative pattern -->
  <div class="absolute inset-0 -z-10 overflow-hidden">
    <svg
      aria-hidden="true"
      class="absolute bottom-0 left-0 w-full h-24 text-gray-100"
    >
      <pattern
        id="footer-pattern"
        x="0"
        y="0"
        width="100"
        height="100"
        patternUnits="userSpaceOnUse"
      >
        <path
          d="M0 50 Q 25 40, 50 50 T 100 50"
          stroke="currentColor"
          stroke-width="0.5"
          fill="none"
          opacity="0.4"></path>
      </pattern>
      <rect width="100%" height="100%" fill="url(#footer-pattern)"></rect>
    </svg>
  </div>
</footer>
