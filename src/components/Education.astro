---
import { siteConfig, getContent } from "../config";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const c = getContent(lang);
const hasEducation = c.education && c.education.length > 0;
---

{
  hasEducation && (
    <section id="education" class="p-8 sm:p-12 md:p-16 lg:px-24 lg:py-16">
      <div>
        <div class="max-w-6xl">
          <div>
            <div class="space-y-8">
              {c.education.map((edu, index) => {
                const color =
                  siteConfig.palette[index % siteConfig.palette.length];
                const logo = "logo" in edu ? (edu.logo as string) : undefined;
                return (
                <div
                  class="gutter bg-[var(--vs-bg-inset)] md:bg-[var(--vs-bg-inset)]/90 md:backdrop-blur-sm rounded-lg shadow-sm border border-[var(--vs-border)] p-4 sm:p-5 md:p-6 pl-6 sm:pl-7 md:pl-8 hover:shadow-md transition-shadow duration-300"
                  style={`--gutter-color: ${color}`}
                >
                  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between mb-4">
                    <div class="flex items-start gap-3 min-w-0">
                      {logo && (
                        <img
                          src={logo}
                          alt=""
                          loading="lazy"
                          decoding="async"
                          width="48"
                          height="48"
                          class="w-11 h-11 sm:w-12 sm:h-12 shrink-0 rounded-md bg-white object-contain p-1 ring-1 ring-[var(--vs-border)]"
                        />
                      )}
                      <div class="min-w-0">
                        <h3 class="text-lg sm:text-xl font-semibold text-[var(--vs-fg)]">
                          {edu.degree}
                        </h3>
                        <p class="text-base sm:text-lg" style={`color: ${color}`}>
                          {edu.school}
                        </p>
                      </div>
                    </div>
                    <span class="text-xs sm:text-sm text-[var(--vs-fg-muted)] mt-2 sm:mt-0 shrink-0 whitespace-nowrap">
                      {edu.dateRange}
                    </span>
                  </div>

                  <ul class="space-y-2">
                    {edu.achievements.map((achievement) => (
                      <li class="flex items-start">
                        <span class="inline-block w-1.5 h-1.5 rounded-full bg-gray-400 mt-2 mr-3 flex-shrink-0" />
                        <span class="text-sm sm:text-base text-gray-600">
                          {achievement}
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>
                );
              })}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
